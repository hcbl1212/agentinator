{
  "name": "agentinator",
  "version": "0.1.0",
  "description": "The visual harness for developing with AI — a mission-control cockpit for AI coding agents.",
  "license": "GPL-3.0-only",
  "author": "hcbl1212",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcbl1212/agentinator.git"
  },
  "type": "module",
  "main": "./out/main/entry.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "prepare": "lefthook install",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --mac --publish never",
    "package:dir": "electron-vite build && electron-builder --mac --dir",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "smoke:claude": "CLAUDE_SMOKE=1 vitest run claude.smoke --coverage.enabled=false",
    "smoke:dogfood": "CLAUDE_SMOKE=1 vitest run dogfood.smoke --coverage.enabled=false",
    "smoke:resume": "CLAUDE_SMOKE=1 vitest run resume.smoke --coverage.enabled=false",
    "smoke:usage": "CLAUDE_SMOKE=1 vitest run usage.smoke --coverage.enabled=false",
    "smoke:auth": "CLAUDE_SMOKE=1 vitest run auth.smoke --coverage.enabled=false",
    "replay:demo": "AGENTINATOR_REPLAY=fixtures/demo-session.json electron-vite dev"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
